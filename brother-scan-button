#!/usr/bin/env python3
"""brother-scan-button: the scan button on Brother scanners, configured with NAPS2.

Brother's `brscan-skey` daemon notices a button press and runs
`brother-scan-button scan --action <image|ocr|email|file> <device> ...`.
Scan settings come from a NAPS2 profile. Pages are scanned with `scanimage`,
so backend options such as Brother's AutoDocumentSize and AutoDeskew work,
and saved with `naps2 console`.

Commands: setup, scan, status, uninstall. See README.md.
https://github.com/afonsofigs/brother-scan-button (MIT licence)
"""

import argparse
import configparser
import contextlib
import datetime as dt
import fcntl
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import traceback
import xml.etree.ElementTree as ET
from pathlib import Path

VERSION = "0.1.0"
APP = "brother-scan-button"

HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
XDG_CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache"))
CONFIG_FILE = Path(os.environ.get("BSB_CONFIG", XDG_CONFIG / APP / "config.ini"))
NAPS2_PROFILES = Path(os.environ.get("BSB_NAPS2_PROFILES", XDG_CONFIG / "naps2" / "profiles.xml"))
LOG_FILE = Path(os.environ.get("BSB_LOG", XDG_CACHE / f"{APP}.log"))
LOCK_FILE = Path(os.environ.get("BSB_LOCK", XDG_CACHE / f"{APP}.lock"))
# Pages in progress. On disk rather than in /tmp, which is RAM on many systems
# and is emptied at boot.
WORK_ROOT = Path(os.environ.get("BSB_WORK", XDG_CACHE / APP / "work"))
INSTALL_PATH = HOME / ".local" / "bin" / APP
SERVICE_NAME = f"{APP}.service"
SERVICE_FILE = XDG_CONFIG / "systemd" / "user" / SERVICE_NAME
# gvfs FUSE mounts (Google Drive, SMB, SFTP...). Overridable for tests.
REMOTE_PREFIX = os.environ.get("BSB_REMOTE_PREFIX", "/run/user/")

SKEY_DIR = Path("/opt/brother/scanner/brscan-skey")
SKEY_CONFIG = SKEY_DIR / "brscan-skey.config"
SKEY_ORIG = Path(f"{SKEY_CONFIG}.orig")
SKEY_EXE = SKEY_DIR / "brscan-skey-exe"
SKEY_ACTIONS = ("IMAGE", "OCR", "EMAIL", "FILE")

DEFAULT_PROFILE = "Scan Button"
PREFERRED_BACKEND_OPTIONS = {"AutoDocumentSize": "yes", "AutoDeskew": "yes"}
# A feeder that never reports "empty" must not fill the disk.
SAFETY_MAX_PAGES = 500
MAX_PAGES_LIMIT = 1000  # all pages go to NAPS2 in one argument, which Linux caps at 128 KiB
# Set from the NAPS2 profile; in `options` they would break the page count.
RESERVED_OPTIONS = {"source", "mode", "resolution", "x", "y", "l", "t", "format", "batch",
                    "batch-count", "batch-start", "batch-increment", "d", "device-name"}

TIMEOUT_SCAN = 30 * 60
TIMEOUT_NAPS2 = 15 * 60
TIMEOUT_GIO = 5 * 60
TIMEOUT_QUICK = 60
UPLOAD_BUDGET = 20 * 60  # all uploads of one press together
LOCK_WAIT = 30 * 60

PAGE_SIZES_MM = {  # NAPS2 PageSize names
    "Letter": (215.9, 279.4), "Legal": (215.9, 355.6),
    "A3": (297, 420), "A4": (210, 297), "A5": (148, 210),
    "B4": (250, 353), "B5": (176, 250),
}
UNIT_MM = {"Inch": 25.4, "Centimetre": 10.0, "Millimetre": 1.0}
FLATBED_RE = r"flatbed|platen|glass"
FEEDER_RE = r"adf|feeder|automatic|document|duplex"
END_OF_FEED_RE = r"out of documents|no docs|document feeder (is )?empty"


def scan_end_reason(stderr):
    """The line of scanimage's stderr that says why scanning stopped. Skips the
    "rounded value" notices and the batch progress lines ("Scanning page 2",
    "Scanned page 2. (scanner status = 7)", "Batch terminated, 2 pages scanned")."""
    sane_errors = [l for l in stderr.splitlines() if re.search(r"sane_(start|read): ", l)]
    if sane_errors:
        return sane_errors[-1].strip()
    lines = [l for l in stderr.strip().splitlines()
             if l.strip() and "rounded value" not in l
             and not re.search(r"batch terminated|^\s*scann(ing|ed) page", l, re.I)]
    return lines[-1] if lines else ""


class ScanError(Exception):
    """The scan did not end with every page at its destination."""


class Interrupted(BaseException):
    """SIGTERM/SIGHUP, e.g. the service being stopped during a scan."""


# --------------------------------------------------------------------------- utils

def log(msg):
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a", encoding="utf-8") as f:
            f.write(f"{dt.datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")
    except OSError as e:
        print(f"{APP}: cannot write {LOG_FILE}: {e}\n{msg}", file=sys.stderr)


def notify(title, body="", urgent=False):
    if os.environ.get("BSB_NO_NOTIFY") or not shutil.which("notify-send"):
        return
    cmd = ["notify-send", "-a", "Scanner", "-i", "scanner"]
    if urgent:
        cmd += ["-u", "critical"]
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        subprocess.run(cmd + [title, body], timeout=10, capture_output=True)


def run(cmd, timeout=TIMEOUT_QUICK):
    """Run a command in its own process group. On timeout or interruption the
    group gets SIGTERM, then SIGKILL; a process stuck in the kernel (a hung FUSE
    mount) is abandoned instead of waited for. A missing program is a ScanError."""
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                             start_new_session=True)
    except FileNotFoundError:
        raise ScanError(f"'{cmd[0]}' is not installed or not on PATH") from None
    try:
        out, err = p.communicate(timeout=timeout)
        return subprocess.CompletedProcess(cmd, p.returncode, out, err)
    except BaseException:
        for sig, grace in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(p.pid, sig)
            try:
                p.communicate(timeout=grace)
                break
            except subprocess.TimeoutExpired:
                continue
        raise


def documents_dir():
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        out = subprocess.run(["xdg-user-dir", "DOCUMENTS"], text=True, capture_output=True,
                             timeout=10).stdout.strip()
        if out and out != str(HOME):
            return Path(out)
    return HOME / "Documents"


def tilde(path):
    s, h = str(path), str(HOME)
    return "~" + s[len(h):] if s == h or s.startswith(h + "/") else s


def default_output_path():
    return str(documents_dir() / "Scans" / "scan_$(YYYY)-$(MM)-$(DD)_$(hh)-$(mm)-$(ss).pdf")


def is_remote(path):
    return str(path).startswith(REMOTE_PREFIX)


def gvfs_path(path):
    """google-drive://user@host/<ids> as copied from Files -> its gvfs FUSE path."""
    m = re.match(r"google-drive://([^@/]+)@([^/]+)(/.*)?$", path)
    if not m:
        return path
    return f"/run/user/{os.getuid()}/gvfs/google-drive:host={m.group(2)},user={m.group(1)}{m.group(3) or '/'}"


def child_ok(cmd, timeout=20):
    """Exit status of a small command, False on timeout. os.path functions can
    block for minutes on a dead gvfs mount, a child process can be abandoned."""
    try:
        return run(cmd, timeout=timeout).returncode == 0
    except (subprocess.TimeoutExpired, ScanError):
        return False


def remote_isdir(path):
    return child_ok(["test", "-d", path])


def gvfs_mount_root(path):
    """/run/user/<uid>/gvfs/<mount>: it exists only while the mount is up. Anything
    created below it otherwise lands on /run/user, which lives in RAM."""
    m = re.match(r"(/run/user/\d+/gvfs/[^/]+)", str(path))
    return m.group(1) if m else None


def folder_label(directory):
    """What to call a destination folder in a notification."""
    if is_remote(directory):
        with contextlib.suppress(subprocess.TimeoutExpired, ScanError):
            r = run(["gio", "info", "-a", "standard::display-name", directory], timeout=20)
            m = re.search(r"standard::display-name: (.*)", r.stdout)
            if r.returncode == 0 and m:
                return m.group(1).strip()
        return os.path.basename(directory)
    return tilde(directory)


@contextlib.contextmanager
def scan_lock():
    """One scan at a time: a second press waits for the first to finish saving."""
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w") as f:
        deadline = time.monotonic() + LOCK_WAIT
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise ScanError("another scan has been running for too long") from None
                time.sleep(1)
        yield


# ---------------------------------------------------------------------- settings

def load_config():
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.read_dict({
        "general": {"profile": DEFAULT_PROFILE},
        "scanner": {"options": "", "max_pages": "0"},
        "output": {"jpeg_quality": "90", "ocr_lang": "",
                   "fallback_dir": str(documents_dir() / "Scans" / "unsent")},
    })
    try:
        cfg.read(str(CONFIG_FILE), encoding="utf-8")
    except configparser.Error as e:
        raise ScanError(f"{CONFIG_FILE}: {e}") from None
    return cfg


def config_int(cfg, section, key, lo=0, hi=None):
    raw = cfg.get(section, key).strip()
    if not re.fullmatch(r"\d+", raw) or int(raw) < lo or (hi is not None and int(raw) > hi):
        limits = f"{lo}-{hi}" if hi is not None else f"{lo} or more"
        raise ScanError(f"{CONFIG_FILE}: [{section}] {key} must be a whole number {limits}, got '{raw}'")
    return int(raw)


def validate_config(cfg):
    config_int(cfg, "scanner", "max_pages", 0, MAX_PAGES_LIMIT)
    config_int(cfg, "output", "jpeg_quality", 0, 100)
    parse_option_string(cfg.get("scanner", "options"))


def parse_option_string(s):
    """'AutoDocumentSize=yes --AutoDeskew=yes' -> {'AutoDocumentSize': 'yes', 'AutoDeskew': 'yes'}"""
    try:
        tokens = shlex.split(s or "")
    except ValueError as e:
        raise ScanError(f"{CONFIG_FILE}: [scanner] options: {e}") from None
    opts = {}
    for tok in tokens:
        name, _, value = tok.lstrip("-").partition("=")
        if name:
            opts[name] = value
    return opts


def profile_for_action(cfg, action):
    return (cfg.get("general", f"profile_{action}", fallback="") if action else "") or cfg.get("general", "profile")


def read_profile(name):
    """Return the NAPS2 profile called `name` as a dict (defaults if not found)."""
    p = {"found": False, "path": default_output_path(), "dpi": 300, "bitdepth": "C24Bit",
         "source": "Feeder", "pagesize": None, "custom_mm": None, "separator": "FilePerScan",
         "rotate": 0.0, "deskew": False, "options": {}}
    try:
        root = ET.parse(NAPS2_PROFILES).getroot()
    except (OSError, ET.ParseError):
        return p
    for prof in root.findall("ScanProfile"):
        if prof.findtext("DisplayName") != name:
            continue
        p["found"] = True
        if prof.findtext("EnableAutoSave") == "true" and prof.findtext("AutoSaveSettings/FilePath"):
            p["path"] = prof.findtext("AutoSaveSettings/FilePath")
            p["separator"] = prof.findtext("AutoSaveSettings/Separator") or p["separator"]
        m = re.fullmatch(r"Dpi(\d+)", prof.findtext("Resolution") or "")
        if m:
            p["dpi"] = int(m.group(1))
        p["bitdepth"] = prof.findtext("BitDepth") or p["bitdepth"]
        p["source"] = prof.findtext("PaperSource") or p["source"]
        p["pagesize"] = prof.findtext("PageSize")
        if p["pagesize"] == "Custom":
            with contextlib.suppress(TypeError, ValueError):
                unit = UNIT_MM.get(prof.findtext("CustomPageSize/Unit") or "Inch", 25.4)
                p["custom_mm"] = (float(prof.findtext("CustomPageSize/Width")) * unit,
                                  float(prof.findtext("CustomPageSize/Height")) * unit)
        with contextlib.suppress(ValueError):
            p["rotate"] = float(prof.findtext("RotateDegrees") or 0)
        p["deskew"] = prof.findtext("AutoDeskew") == "true"
        for opt in prof.findall("KeyValueOptions/Option"):
            if opt.get("name"):
                p["options"][opt.get("name")] = opt.text or ""
        break
    return p


def strip_default(rest):
    """Remove trailing "[default]", "[advanced]", "[inactive]" groups from a `scanimage -A` line.
    Defaults can contain brackets themselves, e.g. "[24bit Color[Fast]]"."""
    rest = rest.rstrip()
    while rest.endswith("]"):
        depth = 0
        for i in range(len(rest) - 1, -1, -1):
            depth += {"]": 1, "[": -1}.get(rest[i], 0)
            if depth == 0:
                break
        if i == 0 or rest[i - 1] != " ":
            break  # the bracket belongs to a value
        rest = rest[:i].rstrip()
    return rest


def parse_device_options(out):
    """Parse `scanimage -A` output into {name: [allowed values] | (min, max) | []}."""
    opts = {}
    for line in out.splitlines():
        m = re.match(r"\s+(?:--([\w-]+)|-([lxyt]))\b(\[=\()?\s*(.*)", line)
        if not m:
            continue
        name, is_bool, rest = m.group(1) or m.group(2), m.group(3), strip_default(m.group(4))
        if is_bool:  # --Name[=(yes|no)]
            rest = rest.removesuffix(")]")
        rng = re.match(r"(-?[\d.]+)\.\.(-?[\d.]+)", rest)
        if rng:
            opts[name] = (float(rng.group(1)), float(rng.group(2)))
        elif rest:
            opts[name] = rest.split("|")
        else:
            opts[name] = []
    return opts


def device_options(device):
    try:
        r = run(["scanimage", "-d", device, "-A"])
    except subprocess.TimeoutExpired:
        raise ScanError(f"the scanner {device} did not answer") from None
    opts = parse_device_options(r.stdout)
    if r.returncode != 0 or not opts:
        detail = (r.stderr or "").strip().splitlines()[-1:] or ["no options listed"]
        raise ScanError(f"could not read the options of {device}: {detail[0]}")
    return opts


def pick_mode(modes, bitdepth):
    if not modes or isinstance(modes, tuple):
        return None
    want = {"C24Bit": "color", "Grayscale": "gray", "BlackAndWhite": "bw"}.get(bitdepth, "color")
    kinds = {
        "color": lambda m: re.search(r"colou?r", m, re.I),
        "gray": lambda m: re.search(r"gr[ae]y", m, re.I),
        "bw": lambda m: re.search(r"lineart|black|binary|b\s*&\s*w|halftone", m, re.I),
    }
    matches = [m for m in modes if kinds[want](m)]
    # true grey/colour before dithered variants
    matches.sort(key=lambda m: bool(re.search(r"diffusion|dither|halftone", m, re.I)))
    return matches[0] if matches else None


def pick_source(sources, source):
    if not sources or isinstance(sources, tuple):
        return None
    patterns = {"Glass": FLATBED_RE, "Feeder": r"adf|feeder|automatic|document", "Duplex": r"duplex"}
    matches = [s for s in sources if re.search(patterns.get(source, patterns["Feeder"]), s, re.I)]
    if source == "Feeder":
        matches = [s for s in matches if not re.search("duplex", s, re.I)] or matches
    return matches[0] if matches else None


def choose_source(sources, wanted):
    """The profile's source, or the closest one the device has."""
    for candidate in (wanted, "Feeder", "Glass", "Duplex"):
        s = pick_source(sources, candidate)
        if s:
            if candidate != wanted:
                log(f"profile asks for {wanted}, scanner has {sources}; using '{s}'")
            return s
    return None


def pick_resolution(values, dpi):
    if isinstance(values, tuple):
        lo, hi = values
        return int(min(max(dpi, lo), hi))
    nums = [int(n) for n in (re.sub(r"\D", "", str(v).split(".")[0]) for v in values or []) if n]
    return min(nums, key=lambda v: abs(v - dpi)) if nums else dpi


# ------------------------------------------------------------------ file names

def expand_date(pattern, now):
    s = pattern
    for key, fmt in (("YYYY", "%Y"), ("YY", "%y"), ("MM", "%m"), ("DD", "%d"),
                     ("hh", "%H"), ("mm", "%M"), ("ss", "%S")):
        s = s.replace(f"$({key})", now.strftime(fmt))
    return s


def resolve_target(pattern, now=None):
    """Profile path -> absolute path with dates filled in. The $(n...) counter stays;
    it is resolved against the destination folder when the files are placed."""
    s = expand_date(gvfs_path(os.path.expanduser(pattern)), now or dt.datetime.now())
    directory, name = os.path.split(s)
    directory = re.sub(r"\$\(n+\)", "1", directory)
    if not os.path.isabs(directory):
        directory = str(documents_dir() / "Scans" / directory)
    return os.path.join(directory, name)


def final_names(name, suffixes, existing):
    """Names for NAPS2's output files (`suffixes` like "", ".1", ".2"), none of them in
    `existing` (case-folded names already in the folder). Mirrors NAPS2: a $(n...)
    counter takes the next free number, other names get " (2)", " (3)"..."""
    stem, ext = os.path.splitext(name)
    m = re.search(r"\$\((n+)\)", stem)
    if m:
        i = 1
        while True:
            s = stem.replace(m.group(0), str(i).zfill(len(m.group(1))), 1)
            names = [s + suf + ext for suf in suffixes]
            prefix = (s + ".").casefold()
            if not any(n.casefold() in existing for n in names) and not any(e.startswith(prefix) for e in existing):
                return names
            i += 1
    names = []
    for suf in suffixes:
        n = unique_name(existing, stem + suf + ext)
        existing.add(n.casefold())
        names.append(n)
    return names


def unique_name(existing, name):
    stem, ext = os.path.splitext(name)
    candidate, i = name, 2
    while candidate.casefold() in existing:
        candidate = f"{stem} ({i}){ext}"
        i += 1
    return candidate


def remote_names(directory):
    """Case-folded file names in a gvfs folder, or None if they can't be read.
    Google Drive lists entries by id; the display name is what users see and
    what `gio copy` targets."""
    try:
        r = run(["gio", "list", "-a", "standard::display-name", directory], timeout=TIMEOUT_QUICK)
    except (subprocess.TimeoutExpired, ScanError):
        return None
    if r.returncode != 0:
        return None
    names = set()
    for line in r.stdout.splitlines():
        m = re.search(r"standard::display-name=(.*)$", line)
        names.add((m.group(1) if m else line.split("\t")[0]).casefold())
    return names


# --------------------------------------------------------------------- scanning

def scanimage_args(device, prof, cfg):
    """Build the scanimage command. Returns (args, batch_count)."""
    dev_opts = device_options(device)
    args = ["scanimage", "-d", device, "--format=png"]

    mode = pick_mode(dev_opts.get("mode"), prof["bitdepth"])
    if mode:
        args += ["--mode", mode]
    args += ["--resolution", str(pick_resolution(dev_opts.get("resolution"), prof["dpi"]))]
    source = choose_source(dev_opts.get("source"), prof["source"])
    if source:
        args += ["--source", source]

    backend = parse_option_string(cfg.get("scanner", "options"))
    backend.update(prof["options"])  # the profile wins
    applied = {}
    for name, value in backend.items():
        if name in RESERVED_OPTIONS:
            log(f"option --{name} is set from the NAPS2 profile; ignored in options")
        elif name in dev_opts:
            args.append(f"--{name}={value}" if value != "" else f"--{name}")
            applied[name] = value
        else:
            log(f"option --{name} is not supported by {device}, ignored")

    auto_size = applied.get("AutoDocumentSize", "").lower() in ("yes", "true", "1")
    size = prof["custom_mm"] or PAGE_SIZES_MM.get(prof["pagesize"] or "")
    x, y = dev_opts.get("x"), dev_opts.get("y")
    if size and not auto_size and isinstance(x, tuple) and isinstance(y, tuple):
        args += ["-x", f"{min(size[0], x[1]):.1f}", "-y", f"{min(size[1], y[1]):.1f}"]

    max_pages = config_int(cfg, "scanner", "max_pages", 0, MAX_PAGES_LIMIT)
    if source and re.search(FEEDER_RE, source, re.I) and not re.search(FLATBED_RE, source, re.I):
        batch_count = max_pages or SAFETY_MAX_PAGES
    elif source is None and max_pages:
        batch_count = max_pages  # no source option: the user says it's a feeder
    else:
        batch_count = 1
    return args, batch_count


def work_root():
    # ';' separates naps2 -i paths, '%' is a scanimage format, '[' is NAPS2 slice notation
    if re.search(r"[;%\[]", str(WORK_ROOT)):
        return Path(tempfile.gettempdir()) / f"{APP}-{os.getuid()}"
    return WORK_ROOT


def new_work_dir():
    root = work_root()
    root.mkdir(parents=True, exist_ok=True)
    return Path(tempfile.mkdtemp(prefix="scan-", dir=root))


def recover_orphans(cfg):
    """Rescue pages left by a scan that was killed, and tell the user at once."""
    root = work_root()
    if not root.is_dir():
        return
    for d in sorted(root.glob("scan-*")):
        files = list(d.rglob("*"))
        if any(time.time() - f.stat().st_mtime < 120 for f in files if f.exists()):
            continue  # still being written, e.g. by a scanimage whose parent was killed
        pages = sorted(d.glob("page-*.png"))
        if pages:
            where = rescue_pages(pages, cfg, "interrupted")
            if not where:
                log(f"could not recover the pages in {d}; they stay there")
                continue
            log(f"RECOVERED {len(pages)} page(s) from {d} to {where}")
            notify("Scanner", f"Pages of an interrupted scan were recovered to {tilde(where)}", urgent=True)
        shutil.rmtree(d, ignore_errors=True)


def rescue_pages(pages, cfg, label="pages"):
    """Copy raw pages into a new folder somewhere lasting. Returns the folder, or None."""
    stamp = dt.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    for base in (os.path.expanduser(cfg.get("output", "fallback_dir")), str(HOME / f"{APP}-rescue")):
        for i in range(1, 1000):
            folder = os.path.join(base, f"{label}_{stamp}" + (f"_{i}" if i > 1 else ""))
            try:
                os.makedirs(folder)
                break
            except FileExistsError:
                continue
            except OSError:
                folder = None
                break
        else:
            folder = None
        if folder is None:
            continue
        try:
            for p in pages:
                shutil.copy2(p, folder)
                with open(os.path.join(folder, p.name), "rb") as f:
                    os.fsync(f.fileno())
            return folder
        except OSError:
            continue
    return None


def scan(device, action=None, dry_run=False):
    """Scan and save. Returns (delivered, kept, warnings): files at the destination,
    files kept in the fallback folder, and problems to report. Raises ScanError."""
    cfg = load_config()
    validate_config(cfg)  # before scanning, not after
    warnings = []
    if not dry_run:
        recover_orphans(cfg)
    profile_name = profile_for_action(cfg, action)
    prof = read_profile(profile_name)
    if not prof["found"]:
        warnings.append(f"NAPS2 profile '{profile_name}' not found; default settings were used")
    target = resolve_target(prof["path"])

    args, batch_count = scanimage_args(device, prof, cfg)
    work = new_work_dir()
    args += [f"--batch={work}/page-%04d.png", f"--batch-count={batch_count}"]
    if dry_run:
        shutil.rmtree(work, ignore_errors=True)
        print(shlex.join(args))
        print(f"target: {target}")
        return [], [], warnings

    delivered, kept = [], []
    try:
        try:
            res = run(args, timeout=TIMEOUT_SCAN)
            stderr, failed = res.stderr or "", res.returncode != 0
        except subprocess.TimeoutExpired as e:
            stderr, failed = f"scanimage timed out after {e.timeout} s", True
        pages = sorted(p for p in work.glob("page-*.png") if p.stat().st_size > 0)
        reason = scan_end_reason(stderr)
        if not pages:
            if re.search(END_OF_FEED_RE, reason, re.I):
                reason = "no paper in the scanner"
            elif re.search("jammed", reason, re.I):
                reason = "paper jam, or no paper in the scanner"
            raise ScanError(f"scan failed on {device}: {reason or 'no pages scanned'}")
        if failed and not re.search(END_OF_FEED_RE, reason, re.I):
            warnings.append(f"scanning stopped early ({reason or 'no reason given'}); saved {len(pages)} page(s)")
            log("scanimage said: " + " | ".join(stderr.strip().splitlines()[-4:]))
        if batch_count == SAFETY_MAX_PAGES and len(pages) >= batch_count:
            warnings.append(f"stopped at the safety limit of {SAFETY_MAX_PAGES} pages (max_pages in config.ini)")
        log(f"scanned {len(pages)} page(s) on {device} [{profile_name}]")

        save(pages, prof, cfg, work, target, delivered, kept, warnings)
        if kept:
            warnings.append(f"{len(kept)} file(s) could not be delivered and were kept in "
                            f"{tilde(os.path.dirname(kept[0]))}")
        return delivered, kept, warnings
    except (Exception, Interrupted, KeyboardInterrupt) as e:
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):  # finish the rescue first
            signal.signal(sig, signal.SIG_IGN)
        pages = sorted(p for p in work.glob("page-*.png") if p.stat().st_size > 0)
        if isinstance(e, ScanError) and not delivered and not kept and not pages:
            raise
        detail = "the scan was interrupted" if isinstance(e, (Interrupted, KeyboardInterrupt)) else (
            str(e) if isinstance(e, ScanError) else f"{type(e).__name__}: {e}")
        if delivered:
            detail += f"; already saved: {', '.join(delivered)}"
        if kept:
            detail += f"; kept: {', '.join(kept)}"
        if pages:
            where = rescue_pages(pages, cfg)
            if where is None:
                where = str(work)
                work = None  # it holds the only copy
            detail += f". The scanned pages were kept in {tilde(where)}"
        raise ScanError(detail) from e
    finally:
        if work is not None:
            shutil.rmtree(work, ignore_errors=True)


def save(pages, prof, cfg, work, target, delivered, kept, warnings):
    """Write the pages with NAPS2 and deliver them. Appends to `delivered` and `kept`
    (the fallback folder) as files are placed."""
    dest_dir, name = os.path.split(target)
    ext = os.path.splitext(name)[1]
    out_dir = work / "out"
    out_dir.mkdir()
    cmd = ["naps2", "console", "-n", "0", "-i", ";".join(map(str, pages)),
           "-o", str(out_dir / f"scan{ext}"), "--jpegquality", cfg.get("output", "jpeg_quality")]
    if prof["separator"] == "FilePerPage" and len(pages) > 1:
        cmd.append("--split")
    if prof["rotate"]:
        cmd += ["--rotate", str(int(prof["rotate"]))]
    if prof["deskew"]:
        cmd.append("--deskew")
    ocr = bool(cfg.get("output", "ocr_lang")) and ext.lower() == ".pdf"
    if ocr:
        cmd += ["--ocrlang", cfg.get("output", "ocr_lang")]
    try:
        res = run(cmd, timeout=TIMEOUT_NAPS2 + (60 * len(pages) if ocr else 0))
    except subprocess.TimeoutExpired:
        raise ScanError("NAPS2 did not finish saving in time") from None
    output = f"{res.stdout}\n{res.stderr}"
    files = sorted(out_dir.iterdir(), key=lambda f: [int(n) if n.isdigit() else n for n in re.split(r"(\d+)", f.name)])
    if res.returncode != 0 or not files:
        raise ScanError(f"NAPS2 could not save the scan: {output.strip()[:300]}")
    if re.search(r"error occurred running OCR", output, re.I):
        warnings.append(f"OCR failed (is the '{cfg.get('output', 'ocr_lang')}' language installed?); "
                        "saved without text")
    suffixes = [f.name[len("scan"):-len(ext) or None] for f in files]

    if is_remote(dest_dir):
        deliver_remote(files, suffixes, name, dest_dir, cfg, delivered, kept)
        return
    os.makedirs(dest_dir, exist_ok=True)
    existing = {n.casefold() for n in os.listdir(dest_dir)}
    for f, final in zip(files, final_names(name, suffixes, existing)):
        delivered.append(place_local(f, dest_dir, final))


def place_local(src, dest_dir, name):
    """Copy without ever replacing an existing file (exclusive create)."""
    stem, ext = os.path.splitext(name)
    i = 1
    while True:
        dest = os.path.join(dest_dir, name if i == 1 else f"{stem} ({i}){ext}")
        try:
            with open(src, "rb") as fin, open(dest, "xb") as fout:
                try:
                    shutil.copyfileobj(fin, fout)
                    fout.flush()
                    os.fsync(fout.fileno())
                except BaseException:
                    fout.close()
                    os.unlink(dest)
                    raise
            os.unlink(src)
            return dest
        except FileExistsError:
            i += 1


def deliver_remote(files, suffixes, name, dest_dir, cfg, delivered, kept):
    root = gvfs_mount_root(dest_dir)
    if root and not remote_isdir(root):
        remount(dest_dir)
    if root and not remote_isdir(root):
        log(f"{root} is not mounted; keeping the files locally")
        existing = None
    else:
        if not remote_isdir(dest_dir):
            child_ok(["gio", "mkdir", "-p", dest_dir], timeout=TIMEOUT_QUICK)
        existing = remote_names(dest_dir) if remote_isdir(dest_dir) else None
        if existing is None:
            log(f"cannot list {dest_dir}; keeping the files locally so nothing is overwritten")
    if existing is None:
        fb = fallback_dir(cfg)
        taken = {n.casefold() for n in os.listdir(fb)}
        for f, final in zip(files, final_names(name, suffixes, taken)):
            kept.append(place_local(f, fb, final))
        return
    deadline = time.monotonic() + UPLOAD_BUDGET
    tries = 3
    for f, final in zip(files, final_names(name, suffixes, existing)):
        dest = os.path.join(dest_dir, final)
        if time.monotonic() < deadline and upload(f, dest, tries, deadline):
            delivered.append(dest)
        else:
            kept.append(place_local(f, fallback_dir(cfg), final))
            tries = 1  # the destination is struggling: don't spend minutes on every file


def fallback_dir(cfg):
    fb = os.path.expanduser(cfg.get("output", "fallback_dir"))
    os.makedirs(fb, exist_ok=True)
    return fb


def remount(dest_dir):
    """Mount a Google Drive account again (its gvfs mount drops now and then).
    Only the account root: a sub-folder URI makes GNOME add one more mount."""
    m = re.match(r"/run/user/\d+/gvfs/google-drive:([^/]+)", dest_dir)
    if not m:
        return
    spec = dict(kv.split("=", 1) for kv in m.group(1).split(",") if "=" in kv)
    if "user" in spec and "host" in spec:
        child_ok(["gio", "mount", f"google-drive://{spec['user']}@{spec['host']}/"], timeout=TIMEOUT_QUICK)
        time.sleep(2)


def upload(src, dest, tries, deadline):
    """gio copy replaces an existing file, so the name is checked right before each copy."""
    dest_dir = os.path.dirname(dest)
    for attempt in range(tries):
        if time.monotonic() > deadline:
            break
        if not remote_isdir(dest_dir):
            remount(dest_dir)
        try:
            exists = run(["test", "-e", dest], timeout=20).returncode == 0
        except (subprocess.TimeoutExpired, ScanError):
            log(f"could not check whether {dest} exists; not risking an overwrite")
            return False
        if exists:
            log(f"{dest} exists; not overwriting it")
            return False
        try:
            res = run(["gio", "copy", str(src), dest], timeout=TIMEOUT_GIO)
            if res.returncode == 0:
                return True
            log(f"upload of {os.path.basename(dest)} failed: {res.stderr.strip()}")
        except subprocess.TimeoutExpired:
            log(f"upload of {os.path.basename(dest)} timed out")
        if attempt + 1 < tries:
            time.sleep(3)
    return False


def find_device():
    """The first Brother scanner SANE knows about."""
    try:
        out = run(["scanimage", "-f", "%d\n"]).stdout.split()
    except (subprocess.TimeoutExpired, ScanError):
        return None
    return next((d for d in out if d.startswith("brother")), None)


def raise_interrupted(signum, frame):
    raise Interrupted()


def cmd_scan(a):
    if a.dry_run:
        try:
            device = a.device or find_device()
            if not device:
                raise ScanError("no Brother scanner found (is it on and plugged in?)")
            _, _, warnings = scan(device, a.action, dry_run=True)
            for w in warnings:
                print(f"warning: {w}", file=sys.stderr)
            return 0
        except ScanError as e:
            print(e, file=sys.stderr)
            return 1
    log(f"scan requested (action={a.action or '-'}, device={a.device or 'auto'})")
    signal.signal(signal.SIGTERM, raise_interrupted)
    signal.signal(signal.SIGHUP, raise_interrupted)
    try:
        with scan_lock():
            device = a.device or find_device()
            if not device:
                raise ScanError("no Brother scanner found (is it on and plugged in?)")
            delivered, kept, warnings = scan(device, a.action)
    except ScanError as e:
        log(f"FAILED: {e}")
        notify("Scan failed", str(e), urgent=True)
        print(e, file=sys.stderr)
        return 1
    except (Interrupted, KeyboardInterrupt):
        log("FAILED: interrupted before scanning")
        return 1
    except Exception as e:  # a press must never fail silently
        log(f"FAILED: unexpected {type(e).__name__}: {e}\n{traceback.format_exc()}")
        notify("Scan failed", f"{type(e).__name__}: {e}", urgent=True)
        raise
    for f in delivered:
        log(f"OK {f}")
    for f in kept:
        log(f"KEPT {f}")
    files = delivered + kept
    for f in files:
        print(f)
    for w in warnings:
        log(f"WARNING: {w}")
    if files:
        by_dir = {}
        for f in files:
            by_dir.setdefault(os.path.dirname(f), []).append(os.path.basename(f))
        body = "\n".join(f"{', '.join(names)}\nin {folder_label(d)}" for d, names in by_dir.items())
        if warnings:
            notify("Scan saved with problems", "\n".join(warnings) + "\n\n" + body, urgent=True)
        else:
            notify("Scan saved", body)
    return 0


