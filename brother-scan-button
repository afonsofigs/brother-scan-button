def xml_escape(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


def profile_xml(name, output_path, device_id, device_name, options, source="Feeder", pagesize="A4"):
    kv = "".join(f'\n      <Option name="{xml_escape(n)}">{xml_escape(v)}</Option>'
                 for n, v in options.items())
    kv_block = f"\n    <KeyValueOptions>{kv}\n    </KeyValueOptions>" if options else ""
    return f"""  <ScanProfile>
    <Version>2</Version>
    <Device>
      <ID>{xml_escape(device_id)}</ID>
      <Name>{xml_escape(device_name)}</Name>
    </Device>
    <DriverName>sane</DriverName>
    <DisplayName>{xml_escape(name)}</DisplayName>
    <IconID>0</IconID>
    <MaxQuality>false</MaxQuality>
    <IsDefault>false</IsDefault>
    <UseNativeUI>false</UseNativeUI>
    <AfterScanScale>OneToOne</AfterScanScale>
    <Brightness>0</Brightness>
    <Contrast>0</Contrast>
    <BitDepth>C24Bit</BitDepth>
    <PageAlign>Right</PageAlign>
    <PageSize>{xml_escape(pagesize)}</PageSize>
    <Resolution>Dpi300</Resolution>
    <PaperSource>{xml_escape(source)}</PaperSource>
    <EnableAutoSave>true</EnableAutoSave>
    <AutoSaveSettings>
      <FilePath>{xml_escape(output_path)}</FilePath>
      <PromptForFilePath>false</PromptForFilePath>
      <ClearImagesAfterSaving>false</ClearImagesAfterSaving>
      <Separator>FilePerScan</Separator>
    </AutoSaveSettings>
    <Quality>90</Quality>
    <AutoDeskew>false</AutoDeskew>
    <RotateDegrees>0</RotateDegrees>
    <ExcludeBlankPages>false</ExcludeBlankPages>
    <BlankPageWhiteThreshold>70</BlankPageWhiteThreshold>
    <BlankPageCoverageThreshold>25</BlankPageCoverageThreshold>{kv_block}
  </ScanProfile>
"""


def add_profile_to_xml(text, block):
    """Insert a <ScanProfile> block into the text of a NAPS2 profiles.xml."""
    if "</ArrayOfScanProfile>" in text:
        return text.replace("</ArrayOfScanProfile>", block + "</ArrayOfScanProfile>", 1)
    m = re.search(r"<ArrayOfScanProfile\b([^>]*?)\s*/>", text)
    if m:
        return text[:m.start()] + f"<ArrayOfScanProfile{m.group(1)}>\n{block}</ArrayOfScanProfile>" + text[m.end():]
    return None


def write_atomic(path, text):
    tmp = Path(f"{path}.{APP}.tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def local_paper_size(locale_output=None):
    """Letter where the locale uses it (LC_PAPER height 279 mm), A4 elsewhere."""
    if locale_output is None:
        try:
            locale_output = subprocess.run(["locale", "-k", "LC_PAPER"], text=True, capture_output=True,
                                           timeout=10).stdout
        except (OSError, subprocess.SubprocessError):
            locale_output = ""
    m = re.search(r"height=(\d+)", locale_output)
    return "Letter" if m and m.group(1) == "279" else "A4"


def ensure_profile(name, device, source):
    if read_profile(name)["found"]:
        print(f"  NAPS2 profile '{name}' already exists, left as is")
        return True
    if subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "naps2"], capture_output=True).returncode == 0:
        print("NAPS2 is open. Close it and run setup again, because NAPS2 overwrites the profile list when it exits.")
        return False
    block = profile_xml(name, default_output_path(), device, device.split(":")[0], {}, source, local_paper_size())
    NAPS2_PROFILES.parent.mkdir(parents=True, exist_ok=True)
    if NAPS2_PROFILES.exists():
        old = NAPS2_PROFILES.read_text(encoding="utf-8-sig")
        new = add_profile_to_xml(old, block)
        if new is None:
            print(f"Cannot add a profile to {NAPS2_PROFILES}: unexpected format. Create '{name}' in NAPS2 instead.")
            return False
        shutil.copy2(NAPS2_PROFILES, f"{NAPS2_PROFILES}.bak")
    else:
        new = ('<?xml version="1.0" encoding="utf-8"?>\n<ArrayOfScanProfile xmlns:xsi="http://www.w3.org/'
               '2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">\n'
               + block + "</ArrayOfScanProfile>\n")
    write_atomic(NAPS2_PROFILES, new)
    print(f"  created NAPS2 profile '{name}' -> {tilde(default_output_path())}")
    return True


def rewrite_skey_config(text, command):
    """Point every brscan-skey action at `command(action)`, keeping other lines."""
    for act in SKEY_ACTIONS:
        line = f'{act}="{command(act)}"'
        if re.search(rf"^{act}=", text, re.M):
            text = re.sub(rf"^{act}=.*$", lambda _: line, text, flags=re.M)
        else:
            text = text.rstrip("\n") + ("\n" if text.strip() else "") + line + "\n"
    return text


def skey_points_here(text):
    cmd = re.escape(shlex.quote(str(INSTALL_PATH)))
    return all(re.search(rf'^{act}="{cmd} ', text, re.M) for act in SKEY_ACTIONS)


def skey_other_users(text):
    """Copies of this tool, installed by someone else, that brscan-skey.config points at."""
    found = set()
    for m in re.finditer(r'^[A-Z]+="(.*)"\s*$', text, re.M):
        with contextlib.suppress(ValueError):
            argv = shlex.split(m.group(1))
            if argv and argv[0].endswith(f"/.local/bin/{APP}"):
                found.add(argv[0])
    return sorted(p for p in found if p != str(INSTALL_PATH))


def skey_command(action):
    return f"{shlex.quote(str(INSTALL_PATH))} scan --action {action.lower()}"


CONFIG_TEMPLATE = """[general]
# NAPS2 profile used by the button
profile = {profile}
# Scanners with a "Scan to" menu can use a profile per function
# profile_image =
# profile_ocr =
# profile_email =
# profile_file =

[scanner]
# Any option listed by `scanimage -d <device> -A`
options = {options}
# Pages per press with a feeder; 0 means until empty, capped at 500
max_pages = 0

[output]
jpeg_quality = 90
# OCR language for PDFs, e.g. eng. Install it first: naps2 console --install ocr-eng
ocr_lang =
# Where scans go when the destination can't be reached
fallback_dir = {fallback}
"""


def set_config_profile(text, profile):
    """Set `profile =` in [general], adding the key or the section if needed."""
    line = f"profile = {profile}"
    new, n = re.subn(r"^[ \t]*profile[ \t]*[=:].*$", lambda _: line, text, count=1, flags=re.M | re.I)
    if n:
        return new
    if re.search(r"^\[general\]\s*$", text, re.M):
        return re.sub(r"^\[general\]\s*$", lambda _: f"[general]\n{line}", text, count=1, flags=re.M)
    return f"[general]\n{line}\n\n{text}"


def listeners():
    """Running brscan-skey-exe processes of any user: [(pid, uid, unit or scope, system)]."""
    r = subprocess.run(["pgrep", "-x", "brscan-skey-exe"], text=True, capture_output=True)
    result = []
    for pid in r.stdout.split():
        uid, unit, system = -1, "unknown", False
        with contextlib.suppress(OSError, ValueError, IndexError, AttributeError):
            status = Path(f"/proc/{pid}/status").read_text()
            uid = int(re.search(r"^Uid:\s+(\d+)", status, re.M).group(1))
            cgroup = Path(f"/proc/{pid}/cgroup").read_text()
            system = "/system.slice/" in cgroup
            unit = next((part for part in reversed(cgroup.strip().split("/"))
                         if part.endswith((".service", ".scope"))), "unknown")
        result.append((pid, uid, unit, system))
    return result


def is_ours(uid, unit):
    return uid == os.getuid() and unit == SERVICE_NAME


def listener_hint(uid, unit, system=False, pid="<pid>"):
    if system:
        return f"a system service ({unit}): sudo systemctl disable --now {shlex.quote(unit)}"
    if uid != os.getuid():
        return f"run by user id {uid} ({unit}): that user can stop it, or root with: sudo kill {pid}"
    if "@autostart" in unit:
        return f"an autostart entry ({unit}): turn it off in your desktop's startup settings"
    if unit.endswith(".service"):
        return f"in {unit}: systemctl --user disable --now {shlex.quote(unit)}"
    return f"in {unit} (started by hand or at login): brscan-skey -t"


def autostart_entries(dirs=None):
    """Enabled autostart entries that start brscan-skey. A user entry with the same
    file name overrides the system one."""
    dirs = dirs or [Path("/etc/xdg/autostart"), XDG_CONFIG / "autostart"]
    entries = {}
    for d in dirs:  # later directories override earlier ones
        for f in sorted(d.glob("*.desktop")) if d.is_dir() else []:
            with contextlib.suppress(OSError):
                entries[f.name] = (f, f.read_text(errors="replace"))
    found = []
    for f, text in entries.values():
        exec_line = re.search(r"^Exec\s*=\s*(.*)$", text, re.M)
        try:
            argv = shlex.split(exec_line.group(1)) if exec_line else []
        except ValueError:
            argv = exec_line.group(1).split()
        if not argv or os.path.basename(argv[0]) not in ("brscan-skey", "brscan-skey-exe") or "-t" in argv[1:]:
            continue
        if re.search(r"^Hidden\s*=\s*true", text, re.M | re.I) or \
           re.search(r"^X-GNOME-Autostart-enabled\s*=\s*false", text, re.M | re.I):
            continue
        found.append(f)
    return found


def systemctl_user(*args):
    return subprocess.run(["systemctl", "--user", *args], text=True, capture_output=True)


def cmd_setup(a):
    if os.geteuid() == 0:
        print("Run setup as your normal user, without sudo. It asks for sudo itself when it needs it.")
        return 1
    missing = []
    for c, hint in (
        ("systemctl", "a systemd user session is required"),
        ("sudo", "needed once, to point Brother's brscan-skey at this tool"),
        ("scanimage", "Debian/Ubuntu sane-utils, Fedora/openSUSE sane-backends, Arch sane"),
        ("naps2", "https://github.com/cyanfish/naps2/releases (.deb/.rpm; Arch: AUR naps2-bin). "
                  "The Flatpak can't see Brother's driver."),
    ):
        if not shutil.which(c):
            missing.append(f"  {c}: {hint}")
    if not SKEY_EXE.exists():
        missing.append("  brscan-skey: https://download.brother.com/welcome/dlf006652/brscan-skey-0.3.4-0.amd64.deb"
                       " or https://download.brother.com/welcome/dlf006650/brscan-skey-0.3.4-0.x86_64.rpm")
    if missing:
        print("Missing requirements:\n" + "\n".join(missing))
        return 1

    configured = None
    if CONFIG_FILE.exists():
        try:
            cfg = load_config()
            validate_config(cfg)
            configured = cfg.get("general", "profile")
        except ScanError as e:
            print(f"Fix the configuration first: {e}")
            return 1

    current = SKEY_CONFIG.read_text() if SKEY_CONFIG.exists() else ""
    others = skey_other_users(current)
    if others and not a.force:
        print(f"{SKEY_CONFIG} points at another user's copy ({', '.join(others)}). "
              "The file is shared by the whole system, so only one user can have the button. "
              "Run setup with --force to take it over.")
        return 1
    other = [(pid, uid, unit, system) for pid, uid, unit, system in listeners() if not is_ours(uid, unit)]
    auto = autostart_entries()
    if other or auto:
        print("Another brscan-skey listener is set up. With two, every press scans twice. Stop it first:")
        for pid, uid, unit, system in other:
            print(f"  pid {pid}: {listener_hint(uid, unit, system, pid)}")
        for f in auto:
            print(f"  autostart entry {f}: turn it off in your desktop's startup settings")
        return 1

    was_active = systemctl_user("is-active", SERVICE_NAME).stdout.strip() in ("active", "activating", "reloading")
    systemctl_user("stop", SERVICE_NAME)  # scanimage can't query the scanner while the listener holds it
    done = False
    try:
        done = _setup_steps(a, current, configured, others) == 0
    finally:
        if not done and was_active:
            systemctl_user("start", SERVICE_NAME)
            time.sleep(2)
            if systemctl_user("is-active", SERVICE_NAME).stdout.strip() == "active":
                print(f"Setup did not finish; {SERVICE_NAME} was restarted as it was.")
            else:
                print(f"Setup did not finish, and {SERVICE_NAME} did not start again. "
                      f"See: journalctl --user -u {APP} -n 50")
    return 0 if done else 1


def _setup_steps(a, current_skey, configured, others):
    time.sleep(1)
    device = a.device or find_device()
    if not device:
        print("No Brother scanner found. Plug it in or press its button to wake it up, check that "
              "`scanimage -L` lists it, and run setup again.")
        return 1
    print(f"Scanner: {device}")
    try:
        dev_opts = device_options(device)
    except ScanError as e:
        print(f"  {e}")
        return 1

    profile = a.profile or configured or DEFAULT_PROFILE
    has_source = bool(dev_opts.get("source"))
    source = "Feeder" if pick_source(dev_opts.get("source"), "Feeder") or not has_source else "Glass"
    if not ensure_profile(profile, device, source):
        return 1

    INSTALL_PATH.parent.mkdir(parents=True, exist_ok=True)
    if Path(__file__).resolve() != INSTALL_PATH.resolve():
        tmp = INSTALL_PATH.with_name(f".{APP}.new")
        shutil.copy2(__file__, tmp)
        tmp.chmod(0o755)
        os.replace(tmp, INSTALL_PATH)  # never a half-written tool
    INSTALL_PATH.chmod(0o755)
    print(f"  installed {INSTALL_PATH}")

    supported = {k: v for k, v in PREFERRED_BACKEND_OPTIONS.items() if k in dev_opts}
    if not CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(CONFIG_TEMPLATE.format(
            profile=profile, options=" ".join(f"{k}={v}" for k, v in supported.items()),
            fallback=tilde(documents_dir() / "Scans" / "unsent")), encoding="utf-8")
        print(f"  created {CONFIG_FILE} (scanner options: {supported or 'none'})")
    elif profile != configured:
        old = CONFIG_FILE.read_text(encoding="utf-8")
        write_atomic(CONFIG_FILE, set_config_profile(old, profile))
        try:
            cfg = load_config()
            validate_config(cfg)
            if cfg.get("general", "profile") != profile:
                raise ScanError("the profile line was not where expected")
        except ScanError as e:
            write_atomic(CONFIG_FILE, old)
            print(f"  could not set the profile in {CONFIG_FILE} ({e}); edit it by hand")
            return 1
        print(f"  {CONFIG_FILE}: profile set to '{profile}'")
    else:
        print(f"  {CONFIG_FILE} already exists, left as is (profile '{profile}')")

    new = rewrite_skey_config(current_skey, skey_command)
    if new != current_skey:
        print(f"  updating {SKEY_CONFIG} (sudo)")
        if SKEY_CONFIG.exists() and not SKEY_ORIG.exists():
            if subprocess.run(["sudo", "cp", "-p", str(SKEY_CONFIG), str(SKEY_ORIG)]).returncode != 0:
                print(f"  could not back up {SKEY_CONFIG}; it was left unchanged")
                return 1
        fd, tmp = tempfile.mkstemp(prefix=f"{APP}-")
        with os.fdopen(fd, "w") as f:
            f.write(new)
        r = subprocess.run(["sudo", "install", "-m", "644", tmp, str(SKEY_CONFIG)])
        os.unlink(tmp)
        if r.returncode != 0:
            print(f"  could not update {SKEY_CONFIG}")
            return 1
    else:
        print(f"  {SKEY_CONFIG} already points here")

    SERVICE_FILE.parent.mkdir(parents=True, exist_ok=True)
    SERVICE_FILE.write_text(f"""[Unit]
Description=Brother scanner button listener ({APP})
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
ExecStart={SKEY_EXE} -f
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target
""")
    systemctl_user("daemon-reload")
    systemctl_user("reset-failed", SERVICE_NAME)
    r = systemctl_user("enable", "--now", SERVICE_NAME)
    time.sleep(5)
    if systemctl_user("is-active", SERVICE_NAME).stdout.strip() != "active":
        print(f"  {SERVICE_NAME} did not start: {r.stderr.strip()}\n"
              f"  See: journalctl --user -u {APP} -n 50")
        return 1
    print(f"  started {SERVICE_NAME}")

    notes = []
    if others:
        notes.append(f"The button was taken over from {', '.join(others)}. That user's listener service "
                     "is still enabled and starts at their login; they should run uninstall.")
    if len([1 for _, uid, _, _ in listeners() if uid == os.getuid()]) > 1:
        notes.append("More than one brscan-skey listener is running; every press will scan twice.")
    if not has_source:
        notes.append("This scanner doesn't say whether it has a feeder. For a feeder, set max_pages "
                     f"in {CONFIG_FILE} so that one press scans every page.")
    if not shutil.which("notify-send"):
        notes.append("notify-send is missing, so there will be no pop-ups; results go to the log only "
                     "(package libnotify-bin, libnotify or libnotify-tools).")
    if not shutil.which("gio"):
        notes.append("gio is missing; Google Drive and network destinations won't work "
                     "(package libglib2.0-bin, glib2 or glib2-tools).")
    if str(INSTALL_PATH.parent) not in os.environ.get("PATH", "").split(":"):
        notes.append(f"{INSTALL_PATH.parent} is not on your PATH; run commands as {INSTALL_PATH}.")
    where = "on the glass" if source == "Glass" else ("in the feeder" if has_source else "in the scanner")
    print(f"\nDone. Put a page {where} and press the scan button.\n"
          f"Settings: NAPS2 -> Profiles -> \"{profile}\" (destination and format are under Auto Save).\n"
          f"Log: {LOG_FILE}")
    for n in notes:
        print(f"Note: {n}")
    return 0


def cmd_uninstall(a):
    if os.geteuid() == 0:
        print("Run uninstall as your normal user, without sudo. It asks for sudo itself when it needs it.")
        return 1
    if shutil.which("systemctl"):
        systemctl_user("disable", "--now", SERVICE_NAME)
        if systemctl_user("is-active", SERVICE_NAME).stdout.strip() not in ("inactive", "failed"):
            print(f"Could not stop {SERVICE_NAME}. Run uninstall from your desktop session; "
                  "nothing was removed.")
            return 1
        SERVICE_FILE.unlink(missing_ok=True)
        systemctl_user("daemon-reload")
        print(f"Removed {SERVICE_NAME}.")
    else:
        print(f"systemctl not found; remove {SERVICE_FILE} by hand if it exists.")
    text = SKEY_CONFIG.read_text() if SKEY_CONFIG.exists() else ""
    others = skey_other_users(text)
    if others:
        print(f"{SKEY_CONFIG} belongs to another user's setup now ({', '.join(others)}); left as is.")
    elif SKEY_ORIG.exists() and str(INSTALL_PATH) in text:
        print(f"Restoring {SKEY_CONFIG} (sudo)")
        if not shutil.which("sudo") or \
           subprocess.run(["sudo", "cp", "-p", str(SKEY_ORIG), str(SKEY_CONFIG)]).returncode != 0:
            print(f"Could not restore {SKEY_CONFIG}. The service is already removed; the file still "
                  f"points at {INSTALL_PATH}, which is left in place so that it stays valid.")
            return 1
    elif str(INSTALL_PATH) in text:
        print(f"No original of {SKEY_CONFIG} was kept; its button lines still point here. "
              "Reinstall Brother's brscan-skey package to reset it.")
    INSTALL_PATH.unlink(missing_ok=True)
    print("Removed the tool. The scan button does nothing until a listener runs again "
          "(Brother's own: run brscan-skey, or turn your brscan-skey autostart entry back on).")
    print("Left in place:")
    for p in (CONFIG_FILE.parent, LOG_FILE, LOCK_FILE, work_root(), HOME / f"{APP}-rescue",
              NAPS2_PROFILES, Path(f"{NAPS2_PROFILES}.bak"), SKEY_ORIG):
        if p.exists():
            print(f"  {p}")
    print("  your NAPS2 profile and any files in the fallback folder")
    if work_root().is_dir() and any(work_root().glob("scan-*/page-*.png")):
        print(f"  {work_root()} holds pages of an interrupted scan; move them somewhere safe")
    return 0


def cmd_status(a):
    healthy = True
    running = listeners()
    if not shutil.which("systemctl"):
        healthy = False
        print("listener service: systemctl not found")
    elif not SERVICE_FILE.exists():
        healthy = False
        print("listener service: not installed (run setup)")
    else:
        state = systemctl_user("is-active", SERVICE_NAME).stdout.strip()
        healthy &= state == "active"
        hint = ""
        if state != "active" and not any(not is_ours(uid, unit) for _, uid, unit, _ in running):
            hint = f"  (start it: systemctl --user reset-failed {APP}; systemctl --user start {APP})"
        print(f"listener service: {state}{hint}")
    print(f"brscan-skey listeners running: {len(running)}")
    for pid, uid, unit, system in running:
        print(f"  pid {pid}: {'this tool' if is_ours(uid, unit) else listener_hint(uid, unit, system, pid)}")
    if len(running) != 1:
        healthy = False
    text = SKEY_CONFIG.read_text() if SKEY_CONFIG.exists() else ""
    points = skey_points_here(text)
    healthy &= points
    print(f"{SKEY_CONFIG}: {'points here' if points else 'does NOT point here for every button (run setup again)'}")
    tool_ok = os.access(INSTALL_PATH, os.X_OK)
    healthy &= tool_ok
    print(f"tool: {INSTALL_PATH} ({'ok' if tool_ok else 'MISSING'})")
    try:
        cfg = load_config()
        validate_config(cfg)
    except ScanError as e:
        healthy = False
        cfg = None
        print(f"config: ERROR {e}")
    if cfg is not None:
        base_opts = parse_option_string(cfg.get("scanner", "options"))
        actions = [None] + [act for act in ("image", "ocr", "email", "file")
                            if cfg.get("general", f"profile_{act}", fallback="")]
        for act in actions:
            name = profile_for_action(cfg, act)
            p = read_profile(name)
            healthy &= p["found"]
            print(f"profile{' for ' + act if act else ''}: {name} ({'found' if p['found'] else 'NOT FOUND, defaults used'})")
            print(f"  output: {p['path']}")
            print(f"  {p['dpi']} dpi, {p['bitdepth']}, source {p['source']}, {p['separator']}")
            opts = dict(base_opts)
            opts.update(p["options"])
            print(f"  scanner options: {opts or 'none'}")
    print(f"log: {LOG_FILE}")
    if LOG_FILE.exists():
        for line in LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()[-8:]:
            print("  " + line)
    print(f"listener output: journalctl --user -u {APP} -n 50")
    print("scanners known to brscan-skey: brscan-skey -l")
    return 0 if healthy else 1


def main(argv=None):
    ap = argparse.ArgumentParser(prog=APP, description="Scan button support for Brother scanners, configured with NAPS2.")
    ap.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("scan", help="scan now (what the button runs)")
    s.add_argument("--action", choices=["image", "ocr", "email", "file"], help="button function (set by brscan-skey)")
    s.add_argument("--dry-run", action="store_true", help="print the scanimage command and the target, then exit")
    s.add_argument("device", nargs="?", help="SANE device (default: first Brother scanner)")
    s.add_argument("rest", nargs="*", help=argparse.SUPPRESS)  # extra args from brscan-skey
    s.set_defaults(func=cmd_scan)

    s = sub.add_parser("setup", help="install and configure")
    s.add_argument("--profile", help=f"NAPS2 profile name (default: the configured one, or '{DEFAULT_PROFILE}')")
    s.add_argument("--device", help="SANE device (default: first Brother scanner)")
    s.add_argument("--force", action="store_true", help="take over brscan-skey.config from another user")
    s.set_defaults(func=cmd_setup)

    sub.add_parser("status", help="check the installation; exit status 1 if something is wrong").set_defaults(func=cmd_status)
    sub.add_parser("uninstall", help="undo setup").set_defaults(func=cmd_uninstall)

    a = ap.parse_args(argv)
    return a.func(a)


if __name__ == "__main__":
    sys.exit(main())
